# Named Redis connections for asynqmon (map of name -> address).
# Use either JSON or comma-separated name=addr pairs.

# JSON map:
# ASYNQMON_REDIS_CONNECTIONS={"redis-a":"redis-a:6379","redis-b":"redis-b:6379"}

# name=addr pairs (handy in .env / docker-compose):
ASYNQMON_REDIS_CONNECTIONS=redis-a=redis-a:6379,redis-b=redis-b:6379

PORT=8080
